{
  "name": "two-faced-pacific",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "An open-source SAR observatory for the NASA Space Apps challenge",
  "scripts": {
    "dev": "node scripts/dev.mjs dev",
    "build": "npm run typecheck && vite build",
    "preview": "node scripts/dev.mjs preview",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/browser-check.mjs",
    "demo": "node scripts/build-demo.mjs",
    "refresh": "python scripts/fetch_context.py && python scripts/news_sentiment.py && python scripts/package_evidence.py",
    "dev:api": "node scripts/dev.mjs api",
    "dev:frontend": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "start": "node scripts/dev.mjs start",
    "test:api": "node scripts/dev.mjs test",
    "test:fullstack": "node scripts/fullstack-check.mjs",
    "check": "npm test && npm run test:api && npm run build",
    "test:satellite": "node scripts/satellite-browser-check.mjs",
    "test:globe-display": "node scripts/globe-display-check.mjs",
    "test:illustrative-globe": "node scripts/illustrative-globe-check.mjs",
    "test:site-timeline": "node scripts/site-timeline-check.mjs",
    "test:weather": "node scripts/weather-browser-check.mjs",
    "test:radar-evidence": "node scripts/radar-evidence-browser-check.mjs",
    "test:site-map": "node scripts/site-map-browser-check.mjs",
    "test:selections": "node scripts/selection-browser-check.mjs",
    "test:accessibility": "node scripts/accessibility-browser-check.mjs",
    "test:startup": "node scripts/startup-browser-check.mjs",
    "test:globe-performance": "node scripts/globe-performance-check.mjs",
    "test:blank-pages": "node scripts/blank-page-check.mjs",
    "test:audit": "node scripts/final-audit-check.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "d3-geo": "3.1.1",
    "globe.gl": "2.32.0",
    "maplibre-gl": "6.18.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "topojson-client": "3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "vite": "6.4.6"
  }
}
